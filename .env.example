# OLTP Database Settings
MYSQL_OLTP_ROOT_PASSWORD=your_oltp_root_password
MYSQL_OLTP_DATABASE=askdata_oltp
MYSQL_OLTP_USER=askdata_user
MYSQL_OLTP_PASSWORD=your_oltp_password
MYSQL_OLTP_HOST=oltp-db
MYSQL_OLTP_PORT=3306

# Data Warehouse Database Settings
MYSQL_DW_ROOT_PASSWORD=your_dw_root_password
MYSQL_DW_DATABASE=askdata_dw
MYSQL_DW_USER=askdata_dw_user
MYSQL_DW_PASSWORD=your_dw_password
MYSQL_DW_HOST=dw-db
MYSQL_DW_PORT=3306

# UI Database Settings
MYSQL_UI_ROOT_PASSWORD=your_ui_password
MYSQL_UI_DATABASE=askdata_ui
MYSQL_UI_USER=askdata_ui_user
MYSQL_UI_PASSWORD=your_ui_password
MYSQL_UI_HOST=ui-db
MYSQL_UI_PORT=3306

# Mongo Database Settings
MONGO_INITDB_ROOT_USERNAME=mongo_root
MONGO_INITDB_ROOT_PASSWORD=mongo_password
MONGO_INITDB_DATABASE=askdata_mongo
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=askdata_mongo
MONGO_URI=mongodb://mongodb:27017/askdata_mongo

# Miscellaneous Settings
PYTHONHTTPSVERIFY=0
CURL_CA_BUNDLE=
REQUESTS_CA_BUNDLE=
SSL_VERIFY=false
JWT_SECRET_KEY=your_jwt_secret_key

# ================================
# ML SYSTEM CONFIGURATION (NEW)
# ================================
# ML Model Parameters
ML_SAMPLE_SIZE=200              # Number of customers for model training
BATCH_SIZE=100                  # Customers processed per batch
MAX_WORKERS=4                   # Parallel processing threads

# Processing Limits
DEFAULT_CUSTOMER_LIMIT=1000     # Default processing limit
MAX_CUSTOMERS_FULL=5000         # Maximum for full processing
MAX_CUSTOMERS_INCREMENTAL=500   # Maximum for incremental updates

# Cleanup Settings
CLEANUP_DAYS=30                 # Days to keep old recommendations

# Performance Tuning
LOG_LEVEL=INFO                  # DEBUG, INFO, WARNING, ERROR
DEBUG_MODE=false
