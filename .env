# Unified Database Settings
PG_COMMON_DB=common-db
COMMON_DB_HOST=common-db

# OLTP Database Settings
OLTP_DATABASE=askdata_oltp
OLTP_USER=askdata_user
OLTP_PASSWORD=askdata_password
OLTP_HOST=common-db
OLTP_PORT=5432

# Data Warehouse Database Settings
DW_DATABASE=askdata_dw
DW_USER=askdata_dw_user
DW_PASSWORD=askdata_dw_password
DW_HOST=common-db
DW_PORT=5432

# UI Database Settings
UI_DATABASE=askdata_ui
UI_USER=askdata_ui_user
UI_PASSWORD=askdata_ui_password
UI_HOST=common-db
UI_PORT=5432

# Mongo Database Settings
MONGO_INITDB_ROOT_USERNAME=mongo_root
MONGO_INITDB_ROOT_PASSWORD=mongo_password
MONGO_INITDB_DATABASE=askdata_mongo
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=askdata_mongo
MONGO_URI=mongodb://mongodb:27017/askdata_mongo

# Miscellaneous Settings
PYTHONHTTPSVERIFY=0
CURL_CA_BUNDLE=
REQUESTS_CA_BUNDLE=
SSL_VERIFY=false
JWT_SECRET_KEY=askdata_jwt_secret_key_1234567890

# SQLAlchemy connection URLs
#OLTP_DB_URL=mysql+mysqlconnector://askdata_user:askdata_password@172.19.0.2:3306/askdata_oltp
#DW_DB_URL=mysql+mysqlconnector://askdata_dw_user:askdata_dw_password@172.19.0.3:3306/askdata_dw
#OLTP_DB_URL=mysql+pymysql://askdata_user:askdata_password@localhost:3306/askdata_oltp
#DW_DB_URL=mysql+pymysql://askdata_dw_user:askdata_dw_password@localhost:3306/askdata_dw
#OLTP_DB_URL=mysql+mysqlconnector://askdata_user:askdata_password@localhost:3306/askdata_oltp
#DW_DB_URL=mysql+mysqlconnector://askdata_dw_user:askdata_dw_password@localhost:3306/askdata_dw

# Add to your existing .env file (don't replace it!)

# ================================
# ML SYSTEM CONFIGURATION
# ================================
# ML Model Parameters
ML_SAMPLE_SIZE=200              # Number of customers for model training
BATCH_SIZE=100                  # Customers processed per batch
MAX_WORKERS=4                   # Parallel processing threads

# Processing Limits
DEFAULT_CUSTOMER_LIMIT=1000     # Default processing limit
MAX_CUSTOMERS_FULL=5000         # Maximum for full processing
MAX_CUSTOMERS_INCREMENTAL=500   # Maximum for incremental updates

# Cleanup Settings
CLEANUP_DAYS=30                 # Days to keep old recommendations

# Performance Tuning
LOG_LEVEL=INFO                  # DEBUG, INFO, WARNING, ERROR
DEBUG_MODE=false
